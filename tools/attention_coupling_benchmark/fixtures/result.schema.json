{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://artificialsweetener.ai/schemas/anima-regional-benchmark-result-v1.json",
  "title": "Anima Regional Prompting Benchmark Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "manifest_sha256",
    "run_id",
    "started_at_utc",
    "completed_at_utc",
    "environment",
    "observations"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "benchmark_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "run_id": {"type": "string", "minLength": 1},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "completed_at_utc": {"type": "string", "format": "date-time"},
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "simple_syrup_commit",
        "comfyui_commit",
        "python_version",
        "torch_version",
        "cuda_version",
        "gpu_name",
        "attention_backend",
        "model_hashes"
      ],
      "properties": {
        "simple_syrup_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "comfyui_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "python_version": {"type": "string", "minLength": 1},
        "torch_version": {"type": "string", "minLength": 1},
        "cuda_version": {"type": "string", "minLength": 1},
        "gpu_name": {"type": "string", "minLength": 1},
        "attention_backend": {"type": "string", "minLength": 1},
        "model_hashes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/observation"}
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "case_id",
        "execution_id",
        "seed",
        "status",
        "output_sha256",
        "runtime_ms",
        "peak_vram_bytes",
        "model_call_count",
        "cross_attention_branch_count",
        "scores",
        "failure_classes",
        "notes",
        "error"
      ],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "case_id": {"type": "string", "minLength": 1},
        "execution_id": {"type": "string", "minLength": 1},
        "seed": {"type": "integer", "minimum": 0},
        "status": {"enum": ["completed", "failed"]},
        "output_sha256": {
          "oneOf": [
            {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            {"type": "null"}
          ]
        },
        "runtime_ms": {"type": ["number", "null"], "minimum": 0},
        "peak_vram_bytes": {"type": ["integer", "null"], "minimum": 0},
        "model_call_count": {"type": ["integer", "null"], "minimum": 0},
        "cross_attention_branch_count": {"type": ["integer", "null"], "minimum": 0},
        "scores": {
          "oneOf": [
            {"$ref": "#/$defs/visual_scores"},
            {"type": "null"}
          ]
        },
        "failure_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "subject_fusion",
              "identity_leakage",
              "attribute_swap",
              "boundary_seam",
              "incompatible_geometry",
              "missing_subject",
              "duplicate_subject",
              "region_nonadherence",
              "prompt_weight_instability",
              "long_prompt_instability",
              "tile_discontinuity",
              "other"
            ]
          }
        },
        "notes": {"type": "string"},
        "error": {"type": ["string", "null"]}
      }
    },
    "visual_scores": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "composition_integrity",
        "region_assignment",
        "boundary_coherence",
        "subject_integrity",
        "prompt_adherence"
      ],
      "properties": {
        "composition_integrity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "0 unusable composition; 4 coherent intended composition."
        },
        "region_assignment": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "0 region instructions absent or reversed; 4 all assignments correct."
        },
        "boundary_coherence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "0 destructive boundary; 4 natural continuity without leakage."
        },
        "subject_integrity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "0 fused or invalid subjects; 4 distinct anatomically coherent subjects."
        },
        "prompt_adherence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "0 core prompt ignored; 4 global and regional prompts clearly satisfied."
        }
      }
    }
  }
}
